#!/bin/sh

set -eu

command=$1
shift

vscode_links='
   /usr/share/bash-completion/completions/code
   /usr/share/code
   /usr/share/mime/packages/code-workspace.xml
   /usr/share/pixmaps/vscode.png
   /usr/share/zsh/vendor-completions/_code
   /etc/vscode
'

# Upstream names these com.microsoft.VSCode.*; keep our own code.* names
# for them instead, since other tooling expects the old names.
vscode_renamed_links='
   /usr/share/appdata/com.microsoft.VSCode.appdata.xml:/usr/share/appdata/code.appdata.xml
   /usr/share/applications/com.microsoft.VSCode.desktop:/usr/share/applications/code.desktop
   /usr/share/applications/com.microsoft.VSCode.UrlHandler.desktop:/usr/share/applications/code-url-handler.desktop
'

case "${command}" in
    configure)
        upstream_dir=$1
        for f in $vscode_links; do
          mkdir -p "$(dirname "$f")"
          ln -fns -T "${upstream_dir}/${f}" "$f"
        done
        for pair in $vscode_renamed_links; do
          src=${pair%%:*}
          dst=${pair#*:}
          mkdir -p "$(dirname "$dst")"
          ln -fns -T "${upstream_dir}/${src}" "$dst"
        done
        ln -fns -T "${upstream_dir}/usr/share/code/code" /usr/local/bin/code
        echo vscode >> /var/lib/puavo-pkg/.update_mime_database
        ;;
    unconfigure)
        rm -f $vscode_links
        for pair in $vscode_renamed_links; do
          rm -f "${pair#*:}"
        done
        rm -f /usr/local/bin/code
        ;;
    unpack)
        upstream_pack=$1
        upstream_dir=$2

        dpkg -x "$upstream_pack" "$upstream_dir"
        # remove the setuid bit, this is run with --no-sandbox anyway
        # (and owner is "puavo-pkg" so it does not help)
        chmod 755 "${upstream_dir}/usr/share/code/chrome-sandbox"
        # copy the customized policy.json
        mkdir -p "${upstream_dir}/etc/vscode"
        cp -p policy.json "${upstream_dir}/etc/vscode/policy.json"
        ;;
    *)
        ;;
esac
