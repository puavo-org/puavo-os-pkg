#!/bin/sh

set -eu

command=$1
shift

case "${command}" in
    configure)
	upstream_dir=$1

	ln -fns "${upstream_dir}/GeoGebra-linux-x64" \
		/opt/GeoGebra-linux-x64
        cat <<'EOF' > /usr/share/applications/geogebra6.desktop
[Desktop Entry]
Name=GeoGebra 6
Exec=/opt/GeoGebra-linux-x64/GeoGebra --disable-gpu-shader-disk-cache
Type=Application
Terminal=false
Icon=glade
StartupNotify=true
StartupWMClass=geogebra
Categories=Education;
EOF
	;;
    unconfigure)
	rm -f /opt/GeoGebra-linux-x64 \
              /usr/share/applications/geogebra6.desktop
	;;
    unpack)
	upstream_pack=$1
	upstream_dir=$2

        unzip -q -d "$upstream_dir" "$upstream_pack"
        chmod 755 "${upstream_dir}/GeoGebra-linux-x64"

        # Remove analytics domains from the request whitelist: the Piwik PRO host is dead and made every start hang until TCP timeout.
        main_js="${upstream_dir}/GeoGebra-linux-x64/resources/app/main.js"
        sed -i \
            -e 's/ "google-analytics\.com", "googletagmanager\.com", \/\/ analytics//' \
            -e '/"geogebra\.containers\.piwik\.pro", "geogebra\.piwik\.pro", \/\/ Piwik/d' \
            "$main_js"
	;;
    *)
	;;
esac
